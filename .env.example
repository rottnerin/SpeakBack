# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# Gemini model to use for grading (must support audio input)
GEMINI_MODEL=gemini-3.8-flash

# Admin login for the /admin dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin session cookie
SESSION_SECRET=change-this-to-a-long-random-string

# Path to the grading rubric, read fresh on every request
FEEDBACK_MD_PATH=./feedback.md
FEEDBACK_MD_PATH_SPANISH_B=./feedback-spanish-b.md

# Google Cloud project for Firestore, which holds submission history. Locally, also run
# `gcloud auth application-default login` once. On Cloud Run this is picked up automatically.
GOOGLE_CLOUD_PROJECT=speakback-gemini

PORT=3000
