# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# Gemini model to use for grading (must support audio input)
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin login for the /admin dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin session cookie
SESSION_SECRET=change-this-to-a-long-random-string

# Path to the grading rubric, read fresh on every request
FEEDBACK_MD_PATH=./feedback.md

PORT=3000
